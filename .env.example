# ============================================================================
# mikulicknjige.com - environment varijable
#
# Ovaj fajl je predlozak za LOKALNI razvoj:  cp .env.example .env
# .env je u .gitignore i NIKAD se ne commituje.
#
# U PRODUKCIJI se ove varijable NE citaju iz .env fajla - postavlja ih
# Dokploy kroz compose environment (vidi docker-compose.yml).
# ============================================================================

# --- OBAVEZNO ---------------------------------------------------------------

# DATABASE_URL: konekcija na MariaDB. Koristi ga Prisma adapter (lib/prisma.ts)
# i Prisma CLI (prisma.config.ts) za migrate/seed.
# Format: mysql://korisnik:lozinka@host:port/baza
# Lozinku URL-encode-uj ako sadrzi @ : / ? # [ ] znakove.
#
# Lokalno host je 127.0.0.1. U kontejneru je ime `db` servisa iz compose
# fajla - app kontejner ima vlastiti loopback, pa 127.0.0.1 tamo ne radi.
DATABASE_URL="mysql://KORISNIK:LOZINKA@127.0.0.1:3306/BAZA"

# COOKIE_SECRET: HMAC-SHA256 kljuc za potpisivanje admin session cookieja
# (lib/auth.ts). NEMA fallback u kodu - ako fali, svaki login baca 500.
# Generisi:  openssl rand -hex 32
# Promjena ove vrijednosti odjavljuje sve admine.
COOKIE_SECRET="generisi_sa_openssl_rand_hex_32"

# NODE_ENV: "production" na serveru, "development" lokalno.
# Kontrolise `secure` flag na admin cookieju (lib/auth.ts) - u produkciji
# bez ovoga bi se session cookie slao i preko HTTP-a.
NODE_ENV="development"


# --- SAMO ZA DOCKER (ne treba lokalno) --------------------------------------

# Lozinke za MariaDB kontejner, cita ih docker-compose.yml.
# U produkciji dolaze iz Dokploy environmenta, ne odavde.
# DB_PASSWORD=""
# DB_ROOT_PASSWORD=""

# PORT: port na kojem sluza Next server. Image ga postavlja na 3006.
# PORT=3006

# HOSTNAME: u kontejneru MORA biti 0.0.0.0, inace je app nedostupna
# izvana i Traefik dobija connection refused. Image to vec postavlja.
# HOSTNAME="0.0.0.0"


# --- SMTP (bez ovoga narudzbe rade, ali se mail ne salje) --------------------

# SMTP_HOST: fallback u kodu je "localhost" (lib/email.ts).
# Ako lokalni MTA ne postoji, sendMail baca gresku.
SMTP_HOST=""

# SMTP_PORT: fallback "587". Za 465 postavi i secure:true u lib/email.ts.
SMTP_PORT=587

# SMTP_USER: ako je prazan, nodemailer ide bez autentikacije (lib/email.ts).
SMTP_USER=""

# SMTP_PASS: lozinka mailboxa.
SMTP_PASS=""

# SMTP_FROM: adresa u From headeru. Fallback lanac: SMTP_FROM -> SMTP_USER
# -> "info@artrabic.ba" (lib/email.ts) - taj zadnji fallback je pogresan
# domen i zavrsit ce u spamu, pa ovo postavi eksplicitno.
SMTP_FROM=""

# ADMIN_EMAIL: gdje stizu obavijesti o novim narudzbama i porukama.
# Isti fallback lanac kao gore.
ADMIN_EMAIL=""


# --- SAMO ZA SEED -----------------------------------------------------------

# Ne drzi ih u .env. Proslijedi ih inline uz komandu:
#   ADMIN_PASSWORD='jaka-lozinka-min-16-znakova' npx prisma db seed
#
# ADMIN_PASSWORD: minimum 16 znakova, seed odbija raditi sa slabijom.
# ADMIN_USERNAME: default je "admin".
